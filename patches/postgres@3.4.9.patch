   function nextWrite(fn) {
+    // Guard against the connection-teardown race: write() schedules nextWrite
+    // via setImmediate when the chunk is small; if sql.end() nulls the socket
+    // before the immediate fires, nextWrite previously crashed with
+    // "Cannot read properties of null (reading 'write')". Treat that as a
+    // benign post-close write — the data is already lost (socket gone) and
+    // the originating query was either confirmed before close or rejected
+    // via the regular sent[]/CONNECTION_CLOSED path. (jaenster patch)
+    if (socket === null) {
+      nextWriteTimer !== null && clearImmediate(nextWriteTimer)
+      chunk = nextWriteTimer = null
+      if (typeof fn === 'function') fn(Errors.connection('CONNECTION_CLOSED', options, null))
+      return false
+    }
     const x = socket.write(chunk, fn)
