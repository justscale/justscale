{
  "name": "@justscale-examples/chat-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Example chat app demonstrating @justscale/websocket alongside SSE, durable processes, and multi-instance coordination",
  "scripts": {
    "build": "node ../../packages/core/typescript/dist/compiler/ptsc.js",
    "test": "node --import @justscale/typescript/register --import tsx --test --test-timeout=30000 --test-force-exit 'test/**/*.test.ts'",
    "typecheck": "node ../../packages/core/typescript/dist/compiler/ptsc.js --noEmit"
  },
  "dependencies": {
    "@justscale/auth": "workspace:*",
    "@justscale/core": "workspace:*",
    "@justscale/http": "workspace:*",
    "@justscale/permission": "workspace:*",
    "@justscale/postgres": "workspace:*",
    "@justscale/sse": "workspace:*",
    "@justscale/websocket": "workspace:*",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@electric-sql/pglite-socket": "^0.1.5",
    "@justscale/hmr": "workspace:*",
    "@justscale/testing": "workspace:*",
    "@justscale/typescript": "workspace:*",
    "@types/node": "^25.6.0",
    "postgres": "^3.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
